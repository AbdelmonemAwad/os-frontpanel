<!-- The place used when os-xgs-npu is not installed: place-menu.sh writes it as Menu/Menu.xml. -->
<menu>
    <!--
        Under System, and not under Interfaces or Services, because the subject of this page is
        the appliance itself: the screen bolted into its front and the keys beside it. It sits
        directly under System as a leaf of its own, the way Snapshots does in the core menu, so no
        order is given - the children of System are otherwise unordered and sort by name, and a
        number invented here would only push Front Panel somewhere no one expects it.
    -->
    <System>
        <FrontPanel VisibleName="Front Panel" cssClass="fa fa-television fa-fw" url="/ui/frontpanel"/>
    </System>
</menu>
